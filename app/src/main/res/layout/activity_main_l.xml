<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainreal"
    android:padding="16dp">

    <!-- ===================================================== -->
    <!-- STATUS -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Connecting..."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/fredoka_one_regular"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- BLUE PROFILE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/profileBlue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="@id/ludoBoardContainer">

        <ImageView
            android:id="@+id/imgProfileBlue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/blue_token" />

        <TextView
            android:id="@+id/txtNameBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_one_regular"
            android:text="Blue"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- RED PROFILE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/profileRed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintEnd_toEndOf="@id/ludoBoardContainer">

        <ImageView
            android:id="@+id/imgProfileRed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/red_token" />

        <TextView
            android:id="@+id/txtNameRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_one_regular"
            android:text="Red"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- LUDO BOARD -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ludoBoardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/profileBlue"
        app:layout_constraintBottom_toTopOf="@id/profileYellow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.example.final_for_ind.screens.dice_board.LudoBoardView
            android:id="@+id/ludoBoardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- YELLOW PROFILE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/profileYellow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/ludoBoardContainer"
        app:layout_constraintBottom_toTopOf="@id/imgDice"
        app:layout_constraintStart_toStartOf="@id/ludoBoardContainer">

        <ImageView
            android:id="@+id/imgProfileYellow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/token_yellow" />

        <TextView
            android:id="@+id/txtNameYellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_one_regular"
            android:text="Yellow"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- GREEN PROFILE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/profileGreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/ludoBoardContainer"
        app:layout_constraintBottom_toTopOf="@id/imgDice"
        app:layout_constraintEnd_toEndOf="@id/ludoBoardContainer">

        <ImageView
            android:id="@+id/imgProfileGreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/green_token" />

        <TextView
            android:id="@+id/txtNameGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_one_regular"
            android:text="Green"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- DICE -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgDice"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/dice_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- TEST BUTTON -->
    <!-- ===================================================== -->

    <Button
        android:id="@+id/btnTestFinishBlue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:backgroundTint="#D32F2F"
        android:text="TEST: FINISH BLUE"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>